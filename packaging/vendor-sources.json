  "ffmpeg_configure": "--disable-static --enable-shared --libdir=/c/cibw/vendor/lib --prefix=/c/cibw/vendor --disable-programs --disable-doc --disable-libxml2 --disable-lzma --disable-libtheora --disable-libfreetype --disable-libfontconfig --disable-libbluray --disable-libopenjpeg --enable-mediafoundation --enable-version3 --disable-alsa --disable-gnutls --enable-libaom --enable-libdav1d --enable-libmp3lame --enable-libopencore-amrnb --enable-libopencore-amrwb --enable-libopus --enable-libspeex --enable-libsvtav1 --enable-libvorbis --enable-libvpx --enable-libwebp --enable-libopenh264 --disable-libxcb --enable-zlib --enable-libx264 --enable-libx265 --enable-nvenc --enable-nvdec --enable-amf --enable-libvpl --disable-encoder='avui,dca,mlp,opus,s302m,sonic,sonic_ls,truehd,vorbis' --disable-decoder=sonic --disable-libjack --disable-indev=jack",
  "build_instructions": "# Matching native audio sources for DisWhisper 0.2.0 Windows x64\n\nThe portable package uses the PyAV 16.1.0 Windows CPython 3.12 wheel. Its\nvendor configuration pins PyAV-Org/pyav-ffmpeg release 8.0.1-3, commit\n9e63121cf6ef9bc1744956c7a4cb772589c80806. No native sources were changed by\nDisWhisper. The recipe archive contains the upstream patches; notably, the\nFFmpeg configure patch changes its license-query output but does not remove\nthe x264/x265 libraries' GPL licenses. We distribute the combined portable\napplication under GPL-3.0-or-later. Original DisWhisper source is available\nunder 0BSD at https://github.com/MaxJafar/DisWhisper/tree/v0.2.0, including the\nrelease source ZIP provided by GitHub. Downloaded model weights are separate.\n\n## Rebuild\n\n1. Extract pyav-ffmpeg-8.0.1-3.tar.gz. The upstream GitHub workflow in\n   .github/workflows/build-ffmpeg.yml describes the build environment:\n   Windows x64, MSYS2 MINGW64, base-devel, openssl-devel, mingw-w64-x86_64-gcc,\n   mingw-w64-x86_64-nasm, Python 3.13, cibuildwheel and delvewheel.\n2. Copy the dependency tarballs from archives/ into the recipe's source/\n   directory, retaining their original filenames. All source archive hashes\n   are recorded in vendor-sources.json. The upstream build script verifies\n   them, applies patches and uses its recorded configure arguments.\n3. Build as described by the workflow, using\n   python scripts/build-ffmpeg.py C:\\cibw\\vendor --community\n   inside that environment. The workflow describes packaging of DLLs.\n4. Extract the PyAV source and build its CPython 3.12 extension as described\n   in .github/workflows/tests.yml, with the rebuilt vendor libraries. Rebuild\n   DisWhisper with the resulting wheel and scripts/build_windows.ps1.\n\nThe portable application uses dynamic libraries, not a statically linked\nFFmpeg executable. Compatible rebuilt DLLs can replace the corresponding\nhashed DLLs under backend/_internal/av.libs; preserve the DLL import names\nor rebuild/repair the PyAV wheel and backend. The upstream wheel repair tool\ndelvewheel documents the hashed DLL names. No signature check prevents local\nmodifications and there is no restriction on reverse engineering for them.\n\nThe compiler/Windows OS runtime files are standard toolchain components.\nGCC's runtime exception and MinGW's notices are included. libiconv source is\nincluded for its LGPL DLL. Python and .NET notices are in the portable ZIP.\n\n## FFmpeg configure line reported by the distributed DLL\n\n--disable-static --enable-shared --libdir=/c/cibw/vendor/lib --prefix=/c/cibw/vendor --disable-programs --disable-doc --disable-libxml2 --disable-lzma --disable-libtheora --disable-libfreetype --disable-libfontconfig --disable-libbluray --disable-libopenjpeg --enable-mediafoundation --enable-version3 --disable-alsa --disable-gnutls --enable-libaom --enable-libdav1d --enable-libmp3lame --enable-libopencore-amrnb --enable-libopencore-amrwb --enable-libopus --enable-libspeex --enable-libsvtav1 --enable-libvorbis --enable-libvpx --enable-libwebp --enable-libopenh264 --disable-libxcb --enable-zlib --enable-libx264 --enable-libx265 --enable-nvenc --enable-nvdec --enable-amf --enable-libvpl --disable-encoder='avui,dca,mlp,opus,s302m,sonic,sonic_ls,truehd,vorbis' --disable-decoder=sonic --disable-libjack --disable-indev=jack\n"
}
