<Application x:Class="DisWhisper.Companion.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="DisWhisperWindowBrush" Color="#E614151B"/>
                    <SolidColorBrush x:Key="DisWhisperCardBrush" Color="#21222B"/>
                    <SolidColorBrush x:Key="DisWhisperStrokeBrush" Color="#34353F"/>
                    <SolidColorBrush x:Key="DisWhisperSoftBrush" Color="#29243E"/>
                    <SolidColorBrush x:Key="DisWhisperHeroBrush" Color="#2D264B"/>
                    <SolidColorBrush x:Key="DisWhisperHeroTextBrush" Color="#F3F0FF"/>
                    <SolidColorBrush x:Key="DisWhisperBrandTextBrush" Color="#BDB2FF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DisWhisperWindowBrush" Color="#E6F6F5FA"/>
                    <SolidColorBrush x:Key="DisWhisperCardBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="DisWhisperStrokeBrush" Color="#E6E3EE"/>
                    <SolidColorBrush x:Key="DisWhisperSoftBrush" Color="#F0EDFC"/>
                    <SolidColorBrush x:Key="DisWhisperHeroBrush" Color="#ECE7FF"/>
                    <SolidColorBrush x:Key="DisWhisperHeroTextBrush" Color="#30244D"/>
                    <SolidColorBrush x:Key="DisWhisperBrandTextBrush" Color="#5947C6"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Color x:Key="SystemAccentColor">#6C5CE7</Color>
            <Color x:Key="SystemAccentColorLight1">#8C7AF0</Color>
            <Color x:Key="SystemAccentColorLight2">#B9ABFF</Color>
            <Color x:Key="SystemAccentColorLight3">#E0D9FF</Color>
            <Color x:Key="SystemAccentColorDark1">#5846C8</Color>
            <Color x:Key="SystemAccentColorDark2">#4532AA</Color>
            <Color x:Key="SystemAccentColorDark3">#32217E</Color>
            <SolidColorBrush x:Key="DisWhisperBrandBrush" Color="#6C5CE7"/>
            <SolidColorBrush x:Key="DisWhisperGreenBrush" Color="#39BFA0"/>
            <SolidColorBrush x:Key="DisWhisperOrangeBrush" Color="#D98641"/>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DisWhisperCardBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource DisWhisperStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="22"/>
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CharacterSpacing" Value="-20"/>
            </Style>
            <Style x:Key="PageDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,5,0,0"/>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="PrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Padding" Value="18,11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="QuietActionStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Padding" Value="16,10"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
