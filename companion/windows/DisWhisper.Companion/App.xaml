<Application
    x:Class="DisWhisper.Companion.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global Accent Colors & Styles -->
            <SolidColorBrush x:Key="DisWhisperBrandBrush" Color="#6C5CE7"/>
            <SolidColorBrush x:Key="DisWhisperGreenBrush" Color="#00B894"/>
            <SolidColorBrush x:Key="DisWhisperOrangeBrush" Color="#E17055"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
