<Window x:Class="DisWhisper.Companion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DisWhisper">
    <Grid x:Name="Shell" Background="{ThemeResource DisWhisperWindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Padding="18,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/DisWhisper.svg" Width="23" Height="23"/>
                <TextBlock Text="DisWhisper" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="/" Margin="6,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Your conversations, written." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <NavigationView x:Name="NavView" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
            PaneDisplayMode="Auto" OpenPaneLength="228" CompactModeThresholdWidth="720" ExpandedModeThresholdWidth="1060"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Margin="20,20,20,18" Spacing="5">
                    <TextBlock Text="YOUR WORKSPACE" FontSize="10" CharacterSpacing="100" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="Make room for the conversation." FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" ToolTipService.ToolTip="Home · Ctrl+1"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Models" Tag="models" ToolTipService.ToolTip="Models · Ctrl+2"><NavigationViewItem.Icon><FontIcon Glyph="&#xE950;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Transcripts" Tag="transcripts" ToolTipService.ToolTip="Transcripts · Ctrl+3"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="Connect Discord" Tag="discord"><NavigationViewItem.Icon><FontIcon Glyph="&#xE902;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Extras" Tag="extras">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;"/></NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Meeting notes" Tag="summaries"/>
                        <NavigationViewItem Content="Cloud providers" Tag="cloud"/>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" ToolTipService.ToolTip="Settings · Ctrl+4"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.PaneFooter>
                <Border Style="{StaticResource CardStyle}" Padding="14" Margin="12,8,12,18" CornerRadius="12">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource DisWhisperOrangeBrush}"/>
                            <TextBlock x:Name="SidebarStatus" Text="Starting local service" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="Free. Local. Yours." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <HyperlinkButton Content="View source ↗" Click="Source_Click" FontSize="11" Padding="0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" Margin="28,16,28,24" CacheSize="8"/>
        </NavigationView>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="HomeShortcut"/>
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="ModelsShortcut"/>
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="TranscriptsShortcut"/>
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="SettingsShortcut"/>
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>
