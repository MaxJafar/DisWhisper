<Page x:Class="DisWhisper.Companion.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="22" Padding="0,0,8,32" MaxWidth="960" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
                <TextBlock Text="Make it yours." Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="A comfortable workspace and sensible defaults for every conversation." Style="{StaticResource PageDescriptionStyle}"/>
            </StackPanel>
            <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}"/>
                    <ComboBox x:Name="ThemeSelector" Header="App theme" SelectedIndex="0" SelectionChanged="Appearance_Changed">
                        <ComboBoxItem Content="Use Windows setting" Tag="system"/>
                        <ComboBoxItem Content="Light" Tag="light"/>
                        <ComboBoxItem Content="Dark" Tag="dark"/>
                    </ComboBox>
                    <ToggleSwitch x:Name="MotionToggle" Header="Smooth transitions" IsOn="True" Toggled="Motion_Changed"/>
                    <TextBlock Text="DisWhisper also respects the Windows animation setting." Style="{StaticResource PageDescriptionStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Text="Speech processing" Style="{StaticResource SectionTitleStyle}"/>
                    <ComboBox x:Name="DeviceSelector" Header="Run local speech models on" SelectedIndex="0">
                        <ComboBoxItem Content="Automatic · use an available GPU, otherwise CPU" Tag="auto"/>
                        <ComboBoxItem Content="CPU" Tag="cpu"/>
                        <ComboBoxItem Content="NVIDIA GPU · CUDA libraries required" Tag="cuda"/>
                    </ComboBox>
                    <TextBox x:Name="LanguageBox" Header="Speech language" Text="auto" PlaceholderText="auto, en, ru, de, tr…"/>
                    <TextBlock Text="Use auto for language detection, or an ISO language code for more predictable results. Vosk models use their own language." Style="{StaticResource PageDescriptionStyle}"/>
                    <ComboBox x:Name="PrecisionSelector" Header="Whisper precision" SelectedIndex="0">
                        <ComboBoxItem Content="Int8 · smaller memory footprint" Tag="int8"/>
                        <ComboBoxItem Content="Float16 · NVIDIA GPU" Tag="float16"/>
                        <ComboBoxItem Content="Float32" Tag="float32"/>
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Text="Meeting transcripts" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBox x:Name="ChannelNameBox" Header="Dedicated Discord channel" Text="live-transcript"/>
                    <ToggleSwitch x:Name="AutoCreateToggle" Header="Create this channel when the bot joins a server" IsOn="True"/>
                    <ToggleSwitch x:Name="AutoPostToggle" Header="Share the complete transcript when a meeting finishes" IsOn="True"/>
                    <ToggleSwitch x:Name="AutoSaveToggle" Header="Save transcripts on this PC" IsOn="True"/>
                    <ToggleSwitch x:Name="AutoConnectToggle" Header="Connect my bot when DisWhisper opens"/>
                    <NumberBox x:Name="EmptyChannelDelay" Header="Finish after everyone leaves · seconds" Value="60" Minimum="0" Maximum="3600" SpinButtonPlacementMode="Compact"/>
                    <TextBlock Text="Set this delay to 0 to finish meetings manually. Closing the window keeps the app in the tray; Quit finishes the meeting and exits." Style="{StaticResource PageDescriptionStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Open app data" Click="OpenData_Click" Style="{StaticResource QuietActionStyle}"/>
                        <Button Content="Discord setup" Click="Discord_Click" Style="{StaticResource QuietActionStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Expander Header="Advanced audio settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="18">
                    <TextBox x:Name="CudaFolderBox" Header="Optional NVIDIA runtime folder" PlaceholderText="Folder containing CUDA 12 and cuDNN 9 DLLs"/>
                    <NumberBox x:Name="ChunkDuration" Header="Audio chunk duration · seconds" Value="2.5" Minimum="0.5" Maximum="10" SmallChange="0.5" SpinButtonPlacementMode="Compact"/>
                    <TextBlock Text="Shorter chunks reduce delay; longer chunks give the model more context." Style="{StaticResource PageDescriptionStyle}"/>
                    <NumberBox x:Name="SilenceThreshold" Header="Silence threshold · RMS" Value="0.01" Minimum="0" Maximum="1" SmallChange="0.002" SpinButtonPlacementMode="Compact"/>
                    <NumberBox x:Name="Debounce" Header="Combine consecutive speech in Discord · seconds" Value="5" Minimum="0.5" Maximum="60" SmallChange="0.5" SpinButtonPlacementMode="Compact"/>
                </StackPanel>
            </Expander>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SaveButton" Content="Save settings" Click="Save_Click" Style="{StaticResource PrimaryActionStyle}"/>
                <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" Width="24" Height="24"/>
            </StackPanel>
            <TextBlock Text="DisWhisper 0.2 · Free and open source. Original code and branding: 0BSD." Style="{StaticResource PageDescriptionStyle}"/>
            <TextBlock Text="Includes FFmpeg and GPL audio codecs. Portable package: GPL-3.0-or-later. Dependency notices are in the app folder; corresponding sources are on the release page." Style="{StaticResource PageDescriptionStyle}"/>
            <HyperlinkButton Content="Licenses and corresponding source" NavigateUri="https://github.com/MaxJafar/DisWhisper/releases/latest" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</Page>
