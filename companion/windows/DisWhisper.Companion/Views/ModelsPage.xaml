<Page x:Class="DisWhisper.Companion.Views.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DisWhisper.Companion.Models" NavigationCacheMode="Required">
    <Page.Resources>
        <DataTemplate x:Key="ModelCard" x:DataType="models:ModelInfo">
            <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="136"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="9">
                        <StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><Border Visibility="{x:Bind RecommendedVisibility}" Background="{ThemeResource DisWhisperSoftBrush}" CornerRadius="5" Padding="7,3"><TextBlock Text="START HERE" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource DisWhisperBrandTextBrush}"/></Border></StackPanel>
                        <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind Details}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource DisWhisperBrandTextBrush}"/>
                        <ProgressBar Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" Value="{x:Bind ProgressValue, Mode=OneWay}" Maximum="100"/>
                        <HyperlinkButton Content="Model details ↗" Tag="{x:Bind SourceUrl}" Click="Source_Click" FontSize="11" Padding="0" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                        <Button Content="{x:Bind DownloadLabel, Mode=OneWay}" Tag="{x:Bind Id}" Click="DownloadModel_Click" Loaded="Action_Loaded"
                            IsEnabled="{x:Bind CanDownload, Mode=OneWay}" Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryActionStyle}"/>
                        <Button Content="{x:Bind ActivationLabel}" Tag="{x:Bind Id}" Click="ActivateModel_Click" Loaded="Action_Loaded"
                            IsEnabled="{x:Bind CanActivate, Mode=OneWay}" HorizontalAlignment="Stretch" Style="{StaticResource QuietActionStyle}"/>
                        <Button Content="Cancel" Tag="{x:Bind Id}" Click="Cancel_Click" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="0,0,4,24">
            <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Models" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Download once. Transcribe locally, whenever you need." Style="{StaticResource PageDescriptionStyle}"/></StackPanel><Button Grid.Column="1" Content="Refresh" VerticalAlignment="Center" Click="Refresh_Click" Style="{StaticResource QuietActionStyle}"/></Grid>
            <InfoBar x:Name="ModelNotice" IsOpen="False" IsClosable="True"/>
            <Border Background="{ThemeResource DisWhisperSoftBrush}" CornerRadius="12" Padding="18"><StackPanel Spacing="7"><TextBlock Text="New here? Start with Whisper base." FontWeight="SemiBold" Foreground="{ThemeResource DisWhisperBrandTextBrush}"/><TextBlock Text="A lightweight multilingual model that runs on your CPU. Try small for more accuracy, or large-v3-turbo with a compatible NVIDIA GPU." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Find a model or language…" TextChanged="Search_Changed" QueryIcon="Find"/>
            <TextBlock Text="Speech recognition" Style="{StaticResource SectionTitleStyle}"/>
            <ItemsControl x:Name="SpeechModels" ItemTemplate="{StaticResource ModelCard}"/>
            <Expander Header="Local meeting notes · optional" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16"><TextBlock Text="Ollama runs the summary model on your PC. Install and start Ollama once, then download a model here." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><HyperlinkButton Content="Get Ollama ↗" Click="Ollama_Click" HorizontalAlignment="Left" Padding="0"/><ItemsControl x:Name="SummaryModels" ItemTemplate="{StaticResource ModelCard}"/></StackPanel>
            </Expander>
            <Expander Header="Cloud speech providers · optional" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16"><TextBlock Text="Cloud providers require your own API key and send speech to that provider. Local models work without these services." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="Set up optional cloud keys →" Click="Cloud_Click" HorizontalAlignment="Left" Style="{StaticResource QuietActionStyle}"/><ItemsControl x:Name="CloudModels" ItemTemplate="{StaticResource ModelCard}"/></StackPanel>
            </Expander>
            <TextBlock Text="Model download sizes are approximate. Individual model licenses are available through Model details." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
