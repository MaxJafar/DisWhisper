<Page x:Class="DisWhisper.Companion.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DisWhisper.Companion.Models" NavigationCacheMode="Required">
    <Grid>
        <VisualStateManager.VisualStateGroups><VisualStateGroup>
            <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="980"/></VisualState.StateTriggers></VisualState>
            <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="ModelCard.(Grid.Column)" Value="0"/><Setter Target="ModelCard.(Grid.Row)" Value="1"/>
                    <Setter Target="ComputeCard.(Grid.Column)" Value="0"/><Setter Target="ComputeCard.(Grid.Row)" Value="2"/>
                    <Setter Target="MetricColumn2.Width" Value="0"/><Setter Target="MetricColumn3.Width" Value="0"/>
                    <Setter Target="HeroLogo.Visibility" Value="Collapsed"/>
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="22" Padding="0,0,4,24">
                <StackPanel><TextBlock Text="Home" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Less note-taking. More conversation." Style="{StaticResource PageDescriptionStyle}"/></StackPanel>
                <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True"/>
                <Border Background="{ThemeResource DisWhisperHeroBrush}" CornerRadius="20" Padding="28">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="12">
                            <TextBlock Text="YOUR CONVERSATIONS, WRITTEN." FontSize="10" CharacterSpacing="100" FontWeight="SemiBold" Foreground="{ThemeResource DisWhisperBrandTextBrush}"/>
                            <TextBlock x:Name="HeroTitle" Text="A home for every conversation." FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource DisWhisperHeroTextBrush}"/>
                            <TextBlock x:Name="HeroDescription" Text="Connect your own Discord bot, choose a speech model, and let the conversation flow." MaxWidth="620" TextWrapping="Wrap" Foreground="{ThemeResource DisWhisperHeroTextBrush}" Opacity="0.8"/>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <Button x:Name="ConnectButton" Content="Set up Discord" Style="{StaticResource PrimaryActionStyle}" Click="Connect_Click"/>
                                <Button Content="Explore models" Style="{StaticResource QuietActionStyle}" Click="Models_Click"/>
                                <ProgressRing x:Name="BusyRing" IsActive="False" Width="22" Height="22" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                        <Image x:Name="HeroLogo" Grid.Column="1" Source="ms-appx:///Assets/DisWhisper.svg" Width="90" Height="90" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="MetricColumn2" Width="*"/><ColumnDefinition x:Name="MetricColumn3" Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10">
                        <TextBlock Text="DISCORD" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="BotStatusText" Text="Not connected" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="VoiceChannelText" Text="Your bot, your server" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel></Border>
                    <Border x:Name="ModelCard" Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="10">
                        <TextBlock Text="SPEECH MODEL" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="EngineNameText" Text="Whisper" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="EngineDetailsText" Text="Choose a model to begin" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel></Border>
                    <Border x:Name="ComputeCard" Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel Spacing="10">
                        <TextBlock Text="PROCESSING" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="DeviceText" Text="On this PC" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PerformanceText" Text="Local speech, without a subscription" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel></Border>
                </Grid>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="18">
                        <Grid><TextBlock Text="Recent conversation" Style="{StaticResource SectionTitleStyle}"/><Button Content="Transcript library →" Click="Library_Click" HorizontalAlignment="Right" Style="{StaticResource QuietActionStyle}"/></Grid>
                        <StackPanel x:Name="EmptyFeed" HorizontalAlignment="Center" Margin="0,28,0,28" Spacing="10">
                            <FontIcon Glyph="&#xE8F2;" FontSize="32" Foreground="{ThemeResource DisWhisperBrandTextBrush}"/>
                            <TextBlock Text="The next conversation starts here." FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Join a Discord voice channel and use /join. Recognized speech will appear here and in your dedicated Discord channel." MaxWidth="430" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ListView x:Name="LiveFeed" SelectionMode="None" MaxHeight="360" Visibility="Collapsed">
                            <ListView.ItemContainerTransitions><TransitionCollection><AddDeleteThemeTransition/></TransitionCollection></ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate><DataTemplate x:DataType="models:LiveTranscript">
                                <Grid Padding="2,12" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Time}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{x:Bind Speaker}" FontWeight="SemiBold" Foreground="{ThemeResource DisWhisperBrandTextBrush}"/><TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel>
                                </Grid>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource DisWhisperSoftBrush}" CornerRadius="12" Padding="18,14"><TextBlock x:Name="PrivacyText" Text="Speech stays on your PC with local models. Discord carries the call and the transcripts you choose to share." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
