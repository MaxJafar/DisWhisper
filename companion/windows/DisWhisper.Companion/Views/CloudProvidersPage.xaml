<Page
    x:Class="DisWhisper.Companion.Views.CloudProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="0,0,16,24">
            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Cloud Provider Integrations" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Connect cloud APIs for ultra-fast LPU transcription (Groq) or AI meeting summaries (Groq, OpenAI, Gemini)" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Groq Cloud Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xEB42;" FontSize="24" Foreground="{StaticResource DisWhisperBrandBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Groq Cloud (Fastest Cloud Whisper &amp; LLM)" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Runs Whisper Large-v3 and Llama 3.3 70B on Groq LPUs at ~200ms latency" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <PasswordBox x:Name="GroqApiKeyBox" Header="Groq API Key (gsk_...)" PlaceholderText="Enter your Groq Cloud API key" PasswordRevealMode="Peek"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Test Groq Connection" Click="TestGroq_Click"/>
                        <Button Content="Get Free Groq Key" Click="OpenGroqConsole_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- OpenAI Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE753;" FontSize="24" Foreground="{StaticResource DisWhisperBrandBrush}"/>
                        <StackPanel>
                            <TextBlock Text="OpenAI (Whisper-1 &amp; GPT-4o)" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Official cloud Whisper transcription and GPT-4o-mini executive meeting summaries" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <PasswordBox x:Name="OpenAiApiKeyBox" Header="OpenAI API Key (sk-...)" PlaceholderText="Enter your OpenAI API key" PasswordRevealMode="Peek"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Test OpenAI Connection" Click="TestOpenAi_Click"/>
                        <Button Content="Get OpenAI Key" Click="OpenOpenAiConsole_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Google Gemini Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE781;" FontSize="24" Foreground="{StaticResource DisWhisperBrandBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Google Gemini (Gemini 1.5 Flash)" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="High-speed summarization with 1M token context for marathon multi-hour meeting sessions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <PasswordBox x:Name="GeminiApiKeyBox" Header="Gemini API Key" PlaceholderText="Enter your Google AI Studio key" PasswordRevealMode="Peek"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Test Gemini Connection" Click="TestGemini_Click"/>
                        <Button Content="Get Gemini Key" Click="OpenGeminiConsole_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Save Action Button -->
            <Button Content="Save &amp; Apply Cloud API Keys" Click="SaveKeys_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Padding="24,10"/>
        </StackPanel>
    </ScrollViewer>
</Page>
