<Page x:Class="DisWhisper.Companion.Views.CloudProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="22" Padding="0,0,8,32" MaxWidth="960" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
                <TextBlock Text="More options, when you need them." Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Local speech models work without API keys. Cloud transcription and notes are optional." Style="{StaticResource PageDescriptionStyle}"/>
            </StackPanel>
            <InfoBar x:Name="Notice" IsOpen="False"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Text="Groq" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Cloud Whisper transcription and meeting notes." Style="{StaticResource PageDescriptionStyle}"/>
                    <PasswordBox x:Name="GroqApiKeyBox" Header="API key" PlaceholderText="Paste a Groq API key" PasswordRevealMode="Peek"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="TestGroqButton" Content="Check new key" Click="Test_Click" Tag="groq" Style="{StaticResource QuietActionStyle}"/>
                        <HyperlinkButton Content="Get an API key" NavigateUri="https://console.groq.com/keys"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock Text="OpenAI" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Cloud Whisper transcription and meeting notes." Style="{StaticResource PageDescriptionStyle}"/>
                    <PasswordBox x:Name="OpenAiApiKeyBox" Header="API key" PlaceholderText="Paste an OpenAI API key" PasswordRevealMode="Peek"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="TestOpenAiButton" Content="Check new key" Click="Test_Click" Tag="openai" Style="{StaticResource QuietActionStyle}"/>
                        <HyperlinkButton Content="Get an API key" NavigateUri="https://platform.openai.com/api-keys"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="Blank fields keep saved keys. Windows protects newly saved credentials for your user account. Cloud providers receive the audio or transcript sent to them and may charge for usage." Style="{StaticResource PageDescriptionStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SaveButton" Content="Save keys" Click="Save_Click" Style="{StaticResource PrimaryActionStyle}"/>
                <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" Width="24" Height="24"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
