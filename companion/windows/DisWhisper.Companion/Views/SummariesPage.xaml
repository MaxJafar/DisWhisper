<Page
    x:Class="DisWhisper.Companion.Views.SummariesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="0,0,16,24">
            <!-- Header -->
            <StackPanel>
                <TextBlock Text="AI Meeting Summaries &amp; Action Items" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Extract executive overviews, key agreements, and delegated action items using Cloud or Local LLMs" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Configuration Bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="TranscriptSelector" Header="Select Recorded Meeting Session" HorizontalAlignment="Stretch" PlaceholderText="Choose a transcript..."/>
                    
                    <ComboBox x:Name="SummarizerProviderBox" Header="LLM Provider" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Cloud (Groq Llama 3.3 70B)" Tag="cloud"/>
                        <ComboBoxItem Content="Cloud (OpenAI GPT-4o-mini)" Tag="openai"/>
                        <ComboBoxItem Content="Local (Ollama On-Device)" Tag="local"/>
                    </ComboBox>

                    <Button Content="Generate Summary" Click="GenerateSummary_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="36"/>
                </Grid>
            </Border>

            <!-- Loading Ring -->
            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center" Spacing="10">
                <ProgressRing IsActive="True" Width="40" Height="40"/>
                <TextBlock Text="Synthesizing meeting insights..." Foreground="{StaticResource DisWhisperBrandBrush}" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Result Box -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <TextBlock Text="📝 Executive Meeting Notes" FontSize="18" FontWeight="SemiBold"/>
                        <Button Content="Copy Summary" Click="CopySummary_Click" HorizontalAlignment="Right" Margin="380,0,0,0">
                            <Button.Icon>
                                <FontIcon Glyph="&#xE8C8;"/>
                            </Button.Icon>
                        </Button>
                    </StackPanel>

                    <TextBox x:Name="SummaryResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="350" FontFamily="Segoe UI Variable Text" PlaceholderText="Select a meeting session above and click 'Generate Summary' to produce structured minutes..."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
