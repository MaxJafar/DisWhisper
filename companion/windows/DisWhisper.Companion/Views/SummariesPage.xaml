<Page x:Class="DisWhisper.Companion.Views.SummariesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="22" Padding="0,0,8,32">
            <StackPanel Spacing="6">
                <TextBlock Text="From conversation to clarity." Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Optional meeting notes, decisions, and action items from a saved transcript." Style="{StaticResource PageDescriptionStyle}"/>
            </StackPanel>
            <InfoBar x:Name="Notice" IsOpen="False"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="18">
                    <ComboBox x:Name="TranscriptSelector" Header="Meeting transcript" HorizontalAlignment="Stretch" PlaceholderText="Choose a meeting" DisplayMemberPath="Title"/>
                    <ComboBox x:Name="ProviderSelector" Header="Generate notes with" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Provider_Changed">
                        <ComboBoxItem Content="Local · Ollama" Tag="local"/>
                        <ComboBoxItem Content="Cloud · Groq" Tag="groq"/>
                        <ComboBoxItem Content="Cloud · OpenAI" Tag="openai"/>
                    </ComboBox>
                    <TextBlock x:Name="PrivacyNote" Text="Local notes require Ollama and a downloaded language model. Your transcript is processed on this PC." Style="{StaticResource PageDescriptionStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="GenerateButton" Content="Generate meeting notes" Click="Generate_Click" Style="{StaticResource PrimaryActionStyle}"/>
                        <Button Content="Set up provider" Click="ProviderSetup_Click" Style="{StaticResource QuietActionStyle}"/>
                        <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" Width="24" Height="24"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="18">
                    <Grid>
                        <TextBlock Text="Meeting notes" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                        <Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" HorizontalAlignment="Right" IsEnabled="False" Style="{StaticResource QuietActionStyle}"/>
                    </Grid>
                    <TextBox x:Name="ResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="300" BorderThickness="0" Background="Transparent" PlaceholderText="Your meeting notes will appear here."/>
                    <TextBlock Text="AI notes can miss context. Check names, decisions, and action items against the original transcript." Style="{StaticResource PageDescriptionStyle}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
