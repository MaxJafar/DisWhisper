<Page x:Class="DisWhisper.Companion.Views.DiscordSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" NavigationCacheMode="Required">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="22" Padding="0,0,4,24" MaxWidth="850" HorizontalAlignment="Stretch">
            <StackPanel><TextBlock Text="Connect Discord" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Your own bot. Your own server. A few steps, once." Style="{StaticResource PageDescriptionStyle}"/></StackPanel>
            <InfoBar x:Name="Notice" IsOpen="False"/>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12"><Border Background="{ThemeResource DisWhisperSoftBrush}" CornerRadius="8" Padding="9,4"><TextBlock Text="01" FontWeight="SemiBold" Foreground="{ThemeResource DisWhisperBrandTextBrush}"/></Border><TextBlock Text="Create your bot" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/></StackPanel>
                <TextBlock Text="Open the Discord Developer Portal, create an application, then open its Bot page. Generate a bot token and copy it." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <HyperlinkButton Content="Open Discord Developer Portal ↗" Click="Portal_Click" Padding="0" HorizontalAlignment="Left"/>
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12"><Border Background="{ThemeResource DisWhisperSoftBrush}" CornerRadius="8" Padding="9,4"><TextBlock Text="02" FontWeight="SemiBold" Foreground="{ThemeResource DisWhisperBrandTextBrush}"/></Border><TextBlock Text="Connect your bot account" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/></StackPanel>
                <PasswordBox x:Name="TokenBox" Header="Bot token" PlaceholderText="Paste your bot token" PasswordRevealMode="Peek" MaxWidth="650" HorizontalAlignment="Stretch"/>
                <TextBlock x:Name="TokenHelp" Text="Saved on this PC. Windows protects saved tokens with your user account." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="CheckButton" Content="Check connection" Click="Check_Click" Style="{StaticResource QuietActionStyle}"/><ProgressRing x:Name="CheckRing" IsActive="False" Width="22" Height="22" Visibility="Collapsed"/><TextBlock x:Name="BotName" VerticalAlignment="Center" Foreground="{ThemeResource DisWhisperBrandTextBrush}" FontWeight="SemiBold"/></StackPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12"><Border Background="{ThemeResource DisWhisperSoftBrush}" CornerRadius="8" Padding="9,4"><TextBlock Text="03" FontWeight="SemiBold" Foreground="{ThemeResource DisWhisperBrandTextBrush}"/></Border><TextBlock Text="Choose your server" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/></StackPanel>
                <TextBlock Text="Invite the bot with the required permissions. DisWhisper creates #live-transcript for recognized speech and completed meeting files." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button x:Name="InviteButton" Content="Invite bot to a server ↗" Click="Invite_Click" IsEnabled="False" Style="{StaticResource QuietActionStyle}"/>
                <ComboBox x:Name="ServerSelector" Header="Server" PlaceholderText="Check your token to list servers" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                <TextBlock Text="After inviting the bot, check the connection again to refresh this list." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="LanguageSelector" Header="Main speech language" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Detect automatically" Tag="auto"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Русский · Russian" Tag="ru"/><ComboBoxItem Content="Türkçe · Turkish" Tag="tr"/><ComboBoxItem Content="Deutsch · German" Tag="de"/><ComboBoxItem Content="Français · French" Tag="fr"/><ComboBoxItem Content="Español · Spanish" Tag="es"/><ComboBoxItem Content="中文 · Chinese" Tag="zh"/>
                </ComboBox>
                <ToggleSwitch x:Name="AutoConnectToggle" Header="Connect this bot when DisWhisper opens" IsOn="True"/>
            </StackPanel></Border>
            <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="SaveButton" Content="Save and choose a speech model →" Click="Save_Click" Style="{StaticResource PrimaryActionStyle}"/><ProgressRing x:Name="SaveRing" IsActive="False" Width="22" Height="22" Visibility="Collapsed"/></StackPanel>
            <TextBlock Text="Use /join in a Discord voice channel to begin. Use /leave to finish. DisWhisper never starts recording just because you open the app." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
