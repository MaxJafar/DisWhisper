# ==========================================
# DisWhisper Configuration
# ==========================================

# Discord Bot Token (Required)
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Target Discord Guild ID for instant slash command registration (Optional)
# If empty, commands register globally (may take up to an hour to propagate)
GUILD_ID=

# Designated text channel name where live transcripts will be streamed
TRANSCRIPT_CHANNEL_NAME=live-transcript

# ==========================================
# Speech-To-Text (STT) Engine Selection
# ==========================================
# Options:
#  - 'sensevoice': Alibaba SenseVoice via sherpa-onnx (Recommended for real-time: <100ms, emotion & event detection)
#  - 'whisper': OpenAI Whisper Large-v3 via faster-whisper (Recommended for multilingual: 99+ languages including Russian)
STT_ENGINE=sensevoice

# SenseVoice Model Repository on Hugging Face (int8 quantized ONNX, ~120MB)
SENSEVOICE_MODEL_ID=csukuangfj/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17

# Enable SenseVoice rich audio events and emotion formatting (😂 [laughter], 👏 [applause], 🎵 [music])
ENABLE_RICH_EVENTS=true

# Whisper Model Configuration (Used when STT_ENGINE=whisper)
# Options: tiny, base, small, medium, large-v1, large-v2, large-v3, large-v3-turbo
WHISPER_MODEL_SIZE=large-v3

# Device for inference: 'cuda' or 'cpu' (defaults to 'cuda' with auto-cpu fallback)
DEVICE=cuda

# Model compute precision:
# For CUDA: 'float16' (recommended for RTX GPUs), 'int8_float16', 'float32'
# For CPU: 'int8', 'float32'
COMPUTE_TYPE=float16

# Language: ISO 639-1 code (e.g. 'en', 'es', 'fr', 'de') or empty string for auto-detection
LANGUAGE=en

# Audio Chunking & Temporal Parameters (seconds)
# Duration of audio slice to feed into transcription engine (2.0 - 5.0 seconds recommended)
CHUNKING_DURATION_SEC=2.5

# Silence threshold (RMS amplitude below this is considered silence and discarded to save GPU compute)
SILENCE_THRESHOLD=0.01

# Continuous speech debouncing timeout (seconds)
# Appends new speech chunks to the existing user message if spoken within this timeframe
CONTINUOUS_SPEECH_TIMEOUT_SEC=5.0

# Automatically export markdown session transcripts to transcripts/ directory
AUTO_SAVE_TRANSCRIPTS=true

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
