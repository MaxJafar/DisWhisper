# CLI configuration. The desktop app stores its own settings in app data.
# Never share a real bot token or commit .env.
DISCORD_TOKEN=
GUILD_ID=
TRANSCRIPT_CHANNEL_NAME=live-transcript
AUTO_CREATE_TRANSCRIPT_CHANNEL=true
AUTO_POST_TRANSCRIPTS=true
AUTO_LEAVE_EMPTY_SEC=60
AUTO_CONNECT_BOT=false

# Free local speech defaults.
STT_ENGINE=whisper
WHISPER_MODEL_SIZE=base
DEVICE=auto
COMPUTE_TYPE=int8
# Optional existing folder containing CUDA 12/cuDNN 9 DLLs (or NVIDIA package subfolders).
CUDA_LIBRARY_DIR=
LANGUAGE=auto
LOCAL_MODEL_DIR=models
SENSEVOICE_MODEL_ID=csukuangfj/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17
ENABLE_RICH_EVENTS=true
VOSK_MODEL_ID=vosk-model-small-en-us-0.15

CHUNKING_DURATION_SEC=2.5
SILENCE_THRESHOLD=0.01
CONTINUOUS_SPEECH_TIMEOUT_SEC=5.0
AUTO_SAVE_TRANSCRIPTS=true
TRANSCRIPT_DIR=transcripts
LOG_LEVEL=INFO

ENABLE_API_SERVER=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8765

# Optional providers; no API keys are needed for local transcription.
GROQ_API_KEY=
OPENAI_API_KEY=
CLOUD_STT_PROVIDER=groq
SUMMARIZER_PROVIDER=local
SUMMARIZER_MODEL=llama-3.3-70b-versatile
LOCAL_LLM_URL=http://localhost:11434
LOCAL_SUMMARIZER_MODEL=llama3.2:3b
